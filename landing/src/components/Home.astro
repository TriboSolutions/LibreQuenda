<script>
  // ---- counters ----
  document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
    const target = Number(el.dataset.count);
    const box = el.closest("[data-reveal]")!;
    box.addEventListener("revealed", () => {
      if (target === 0) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  });

  // ---- a list that drives a phone: auto-advance, click to jump ----
  function linked(listSel: string, itemAttr: string, phoneId: string, every: number, onCls: string[] = ["on"]) {
    const list = document.querySelector<HTMLElement>(listSel);
    const phone = document.getElementById(phoneId);
    if (!list || !phone) return;
    const items = [...list.querySelectorAll<HTMLElement>(`[${itemAttr}]`)];
    let i = 0;
    let timer = 0;
    const go = (n: number) => {
      items[i].classList.remove(...onCls);
      i = (n + items.length) % items.length;
      // restart the progress bar
      void items[i].offsetWidth;
      items[i].classList.add(...onCls);
      phone.dispatchEvent(new CustomEvent("phone:show", { detail: i }));
    };
    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => go(i + 1), every);
    };
    items.forEach((it, n) =>
      it.addEventListener("click", () => {
        go(n);
        start();
      }),
    );
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(timer))).observe(phone);
  }
  linked("[data-features]", "data-feature", "phone-resident", 4000, ["on", "bg-card", "shadow-sm"]);
  linked("[data-doors]", "data-door", "phone-door", 2400, ["on", "bg-white/10", "border-[#3fb0dd]/60"]);
  const doorPhone = document.getElementById("phone-door");
  const scan = document.querySelector<HTMLElement>("[data-scan]");
  doorPhone?.addEventListener("phone:show", (e) => {
    scan?.classList.toggle("opacity-0", (e as CustomEvent<number>).detail !== 0);
  });

  // ---- council tabs ----
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  if (tabs) {
    const btns = [...tabs.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...tabs.querySelectorAll<HTMLElement>(".panel")];
    let cur = 0;
    let timer = 0;
    const show = (n: number) => {
      btns[cur].setAttribute("aria-selected", "false");
      panels[cur].classList.remove("on");
      cur = (n + btns.length) % btns.length;
      btns[cur].setAttribute("aria-selected", "true");
      panels[cur].classList.add("on");
    };
    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => show(cur + 1), 3800);
    };
    btns.forEach((b, n) =>
      b.addEventListener("click", () => {
        show(n);
        clearInterval(timer); // a chosen tab stays
      }),
    );
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(timer)), { threshold: 0.4 }).observe(tabs);
  }

  // ---- typing question ----
  const typer = document.querySelector<HTMLElement>("[data-typer]");
  if (typer) {
    const out = typer.querySelector<HTMLElement>("[data-typed]")!;
    const qs: string[] = JSON.parse(typer.dataset.questions ?? "[]");
    let q = 0;
    const type = (s: string, k = 0) => {
      out.textContent = s.slice(0, k);
      if (k < s.length) setTimeout(() => type(s, k + 1), 38);
      else setTimeout(() => erase(s, s.length), 2200);
    };
    const erase = (s: string, k: number) => {
      out.textContent = s.slice(0, k);
      if (k > 0) setTimeout(() => erase(s, k - 1), 14);
      else {
        q = (q + 1) % qs.length;
        // regrow the bars for the new answer
        typer.classList.remove("in");
        void typer.offsetWidth;
        typer.classList.add("in");
        setTimeout(() => type(qs[q]), 300);
      }
    };
    typer.addEventListener("revealed", () => setTimeout(() => type(qs[0]), 400), { once: true });
  }

  // ---- languages ----
  const langs = document.querySelector<HTMLElement>("[data-langs]");
  if (langs) {
    const words = [...langs.querySelectorAll<HTMLElement>(".word")];
    const chips = [...langs.querySelectorAll<HTMLElement>("[data-lang-chip]")];
    let w = 0;
    setInterval(() => {
      const prev = words[w];
      prev.classList.remove("on");
      prev.classList.add("out");
      setTimeout(() => prev.classList.remove("out"), 600);
      w = (w + 1) % words.length;
      words[w].classList.add("on");
      chips.forEach((c, n) => {
        const on = n === w;
        c.classList.toggle("border-brand-blue", on);
        c.classList.toggle("bg-brand-blue", on);
        c.classList.toggle("text-white", on);
        c.classList.toggle("border-border", !on);
        c.classList.toggle("text-muted-foreground", !on);
      });
    }, 1800);
  }

  // ---- the star pops on hover, like rating in the app ----
  document.querySelectorAll<HTMLElement>("[data-star-btn]").forEach((b) => {
    const icon = b.querySelector("[data-star-icon]")!;
    b.addEventListener("mouseenter", () => {
      icon.classList.remove("star-pop");
      void (icon as HTMLElement).getBoundingClientRect();
      icon.classList.add("star-pop");
    });
  });
</script>
