      <div data-reveal="zoom" class="relative mt-14 grid items-center gap-10 overflow-hidden rounded-3xl bg-[#0b2544] px-6 py-12 text-white sm:px-12 md:grid-cols-[auto_1fr]">
        <div class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-[radial-gradient(circle,rgba(0,150,209,.35),transparent_65%)]"></div>
