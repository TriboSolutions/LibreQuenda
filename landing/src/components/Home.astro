---
import { Image } from "astro:assets";
import {
  ArrowRight, Star, Search, CalendarCheck, Users, DoorOpen, MessageSquareWarning,
  QrCode, Printer, Hash, Nfc, UserCheck, Building2, CalendarClock, PartyPopper, ChartColumn,
  Wrench, ScrollText, Sparkles, Bot, Smartphone, Code2, Languages, Accessibility, Server,
  Scale, GitFork, BookOpen, Check, ShieldCheck, LockKeyhole, Database, HardDrive, Image as ImageIcon, CloudOff,
} from "@lucide/astro";
import Base from "../layouts/Base.astro";
import { DICT, href, type Lang } from "../i18n";
import Github from "./GithubIcon.astro";
import Phone from "./Phone.astro";
import Browser from "./Browser.astro";
import DayStrip from "./DayStrip.astro";
import Code from "./Code.astro";
import { REPO, INSTALL, DEMO, PLAY } from "../site";

// screenshots: the same ones as the README and the wiki (docs/screenshots)
import aHome from "../../../docs/screenshots/android/vecino/facilities/home.webp";
import aDetail from "../../../docs/screenshots/android/vecino/facilities/facility-detail.webp";
import aMap from "../../../docs/screenshots/android/vecino/facilities/facilities-map.webp";
import aRules from "../../../docs/screenshots/android/vecino/booking/01-checkout-rules.webp";
import aPublic from "../../../docs/screenshots/android/vecino/booking/02-booking-public.webp";
import aGames from "../../../docs/screenshots/android/vecino/booking/05-public-games.webp";
import aFlash from "../../../docs/screenshots/android/vecino/flash/08-flash-booking.webp";
import aIn from "../../../docs/screenshots/android/vecino/entrance/09-checked-in.webp";
import aUpcoming from "../../../docs/screenshots/android/vecino/my-bookings/01-upcoming.webp";
import aRate from "../../../docs/screenshots/android/vecino/participation/01-rate-booking.webp";
import aEvent from "../../../docs/screenshots/android/vecino/booking/08-council-event.webp";
import aLight from "../../../docs/screenshots/android/vecino/account/09-home-light-theme.webp";
import aIssue from "../../../docs/screenshots/android/vecino/participation/04-issue-urgent.webp";
import fReader from "../../../docs/screenshots/android/vecino/flash/01-reader-qr.webp";
import fCode from "../../../docs/screenshots/android/vecino/flash/02-entry-code.webp";
import fDoor from "../../../docs/screenshots/android/vecino/flash/03-door-qr.webp";
import fNfc from "../../../docs/screenshots/android/vecino/flash/04-nfc-tag.webp";
import fStaff from "../../../docs/screenshots/android/vecino/flash/05-staff.webp";

import wHome from "../../../docs/screenshots/web/vecino/facilities/01-home.webp";
import wHomeDark from "../../../docs/screenshots/web/vecino/account/02-home-dark.webp";
import wFacility from "../../../docs/screenshots/web/vecino/facilities/04-facility-page.webp";
import wBookings from "../../../docs/screenshots/web/vecino/my-bookings/01-my-bookings.webp";
import wEvent from "../../../docs/screenshots/web/vecino/events/01-facility-with-event.webp";
import wNotices from "../../../docs/screenshots/web/vecino/participation/03-notices.webp";
import wWeather from "../../../docs/screenshots/web/vecino/weather/01-facility-page.webp";
import cList from "../../../docs/screenshots/web/concello/facilities/01-list.webp";
import cCalendar from "../../../docs/screenshots/web/concello/staff-booking/01-calendar.webp";
import cEvent from "../../../docs/screenshots/web/concello/events/06-event-created.webp";
import cAnalytics from "../../../docs/screenshots/web/concello/analytics/02-overview-full.webp";
import cIssues from "../../../docs/screenshots/web/concello/issues/01-issues-list.webp";
import cLog from "../../../docs/screenshots/web/concello/council-admin/06-activity-log.webp";
import cSheet from "../../../docs/screenshots/web/concello/checkin-setup/03-printable-sheet.webp";
import cWidget from "../../../docs/screenshots/web/concello/widget/02-widget-embedded.webp";
import cBraille from "../../../docs/screenshots/web/concello/checkin-setup/04-printable-code-braille.webp";
import sCouncils from "../../../docs/screenshots/web/superadmin/councils/02-councils-full.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];

const heroScreens = [
  { src: aHome, alt: t.hero.altScreens[0] },
  { src: aDetail, alt: t.hero.altScreens[1] },
  { src: aFlash, alt: t.hero.altScreens[2] },
  { src: aIn, alt: t.hero.altScreens[3] },
  { src: aUpcoming, alt: t.hero.altScreens[4] },
];

const resident = [
  { icon: Search, ...t.residents.items[0], src: aMap },
  { icon: CalendarCheck, ...t.residents.items[1], src: aRules },
  { icon: Users, ...t.residents.items[2], src: aGames },
  { icon: PartyPopper, ...t.residents.items[3], src: aEvent },
  { icon: MessageSquareWarning, ...t.residents.items[4], src: aRate },
];

const doors = [
  { icon: QrCode, title: t.door.ways[0], src: fReader },
  { icon: Hash, title: t.door.ways[1], src: fCode },
  { icon: Printer, title: t.door.ways[2], src: fDoor },
  { icon: Nfc, title: t.door.ways[3], src: fNfc },
  { icon: UserCheck, title: t.door.ways[4], src: fStaff },
];

const council = [
  { icon: Building2, label: t.council.tabs[0], src: cList },
  { icon: CalendarClock, label: t.council.tabs[1], src: cCalendar },
  { icon: PartyPopper, label: t.council.tabs[2], src: cEvent },
  { icon: ChartColumn, label: t.council.tabs[3], src: cAnalytics },
  { icon: Wrench, label: t.council.tabs[4], src: cIssues },
  { icon: ScrollText, label: t.council.tabs[5], src: cLog },
];

const galleryWeb = [wHome, wFacility, wEvent, wBookings, wNotices, wWeather, wHomeDark, sCouncils];
const galleryApp = [aHome, aGames, aPublic, aLight, aIn, aIssue, aUpcoming, aEvent, aDetail];

const facts = [
  { n: 4, suffix: "", label: t.facts[0] },
  { n: 5, suffix: "", label: t.facts[1] },
  { n: 2, suffix: "", label: t.facts[2] },
  { n: 0, suffix: " €", label: t.facts[3] },
];
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
>
  <!-- ============ HERO ============ -->
  <section class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-36 lg:pb-28">
    <div class="dots absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)]"></div>
    <div class="absolute -top-40 left-1/2 -z-10 size-[56rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,var(--glow),transparent_65%)]"></div>
    <img src="/mark.svg" alt="" class="spin-slow pointer-events-none absolute -right-40 top-24 -z-10 hidden size-[34rem] opacity-[0.05] lg:block dark:opacity-[0.07]" />

    <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <a
          href="https://www.agasol.gal/i-certame-gobtec/"
          class="rise inline-flex items-center gap-2 rounded-full border border-border bg-card/70 py-1 pl-1 pr-3 text-xs text-muted-foreground backdrop-blur hover:border-brand-blue/40 transition-colors"
        >
          <span class="rounded-full bg-accent px-2 py-0.5 font-medium text-accent-foreground">AGPL-3.0</span>
          {t.hero.pill}
          <ArrowRight class="size-3" />
        </a>
        <h1 class="rise mt-6 text-[2.6rem] font-semibold leading-[1.05] tracking-tight sm:text-6xl" style="--d:80ms">
          {t.hero.title1}<br />
          <span class="bg-gradient-to-r from-brand-blue to-[#3fb0dd] bg-clip-text text-transparent">{t.hero.title2}</span>
        </h1>
        <p class="rise mt-6 max-w-md text-lg text-muted-foreground" style="--d:160ms">
          {t.hero.lead}
        </p>
        <div class="rise mt-9 flex flex-wrap gap-3" style="--d:240ms">
          <a
            href={DEMO}
            class="group inline-flex h-11 items-center gap-2 rounded-md bg-primary px-5 font-medium text-primary-foreground shadow-lg shadow-primary/20 hover:-translate-y-0.5 hover:shadow-xl transition-all"
          >
            {t.hero.demo}
            <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
          </a>
          <a
            href={href(lang, "/instalar")}
            class="group inline-flex h-11 items-center gap-2 rounded-md border border-border bg-card px-5 font-medium hover:border-brand-blue/50 hover:-translate-y-0.5 transition-all"
          >
            {t.hero.install}
          </a>
          <a
            href={REPO}
            class="group inline-flex h-11 items-center gap-2 rounded-md border border-border bg-card px-5 font-medium hover:border-brand-blue/50 hover:-translate-y-0.5 transition-all"
          >
            <Github class="size-4" />
            {t.hero.code}
          </a>
        </div>
        <!-- the demo app, on Google Play -->
        <a
          href={PLAY}
          class="rise group relative mt-8 flex w-fit max-w-full items-center gap-4 rounded-2xl border border-brand-blue/30 bg-card/80 p-2 pr-5 shadow-lg shadow-brand-blue/10 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-brand-blue/60 hover:shadow-xl"
          style="--d:320ms"
        >
          <span class="absolute -right-2 -top-2.5 flex items-center">
            <span class="ping-ring absolute inset-0 rounded-full bg-brand-blue"></span>
            <span class="relative rounded-full bg-brand-blue px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-wider text-white">{t.hero.play.new}</span>
          </span>
          <span class="relative flex shrink-0 items-center gap-2.5 overflow-hidden rounded-xl bg-black px-3.5 py-2 text-white shimmer">
            <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
              <path fill="#34A853" d="M3.6 1.8 13.8 12l3-3L5.1 2c-.5-.3-1.1-.35-1.5-.2Z" />
              <path fill="#FBBC04" d="m16.8 9-3 3 3 3 3.5-2c.8-.45.8-1.55 0-2Z" />
              <path fill="#EA4335" d="M13.8 12 3.6 22.2c.4.15 1 .1 1.5-.2l11.7-7Z" />
              <path fill="#4285F4" d="M3.6 1.8C3.25 2 3 2.4 3 2.9v18.2c0 .5.25.9.6 1.1L13.8 12Z" />
            </svg>
            <span class="leading-none">
              <span class="block text-[0.65rem] uppercase tracking-wide opacity-80">{t.hero.play.on}</span>
              <span class="mt-0.5 block text-lg font-semibold tracking-tight">Google Play</span>
            </span>
          </span>
          <span class="flex items-center gap-1.5 font-medium">
            {t.hero.play.text}
            <ArrowRight class="size-4 shrink-0 text-brand-blue transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      </div>

      <!-- browser + phone -->
      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div class="rise float-slow" style="--d:200ms">
          <Browser>
            <Image src={wHome} alt={t.hero.altWeb} widths={[600, 1200]} sizes="(min-width:1024px) 560px, 90vw" loading="eager" class="h-full w-full object-cover object-top dark:hidden" />
            <Image src={wHomeDark} alt={t.hero.altWebDark} widths={[600, 1200]} sizes="(min-width:1024px) 560px, 90vw" class="hidden h-full w-full object-cover object-top dark:block" />
          </Browser>
        </div>
        <div class="rise absolute -bottom-12 -right-2 w-[34%] min-w-[130px] sm:-right-6" style="--d:420ms">
          <div class="float">
            <Phone screens={heroScreens} interval={2600} eager />
          </div>
        </div>
        <!-- floating chips, like the app's pills -->
        <div class="pop-in absolute -left-3 top-[38%] hidden sm:block" style="--d:1100ms">
          <div class="float flex items-center gap-2 rounded-full border border-border bg-card px-3 py-2 text-sm shadow-lg">
            <span class="grid size-6 place-items-center rounded-full bg-[#16a34a]"><Check class="size-3.5 text-white" stroke-width={3} /></span>
            {t.hero.checkedIn}
          </div>
        </div>
        <div class="pop-in absolute -top-5 left-[18%] hidden sm:block" style="--d:1400ms">
          <div class="float-slow rounded-full bg-positive-bg px-3 py-1.5 text-sm font-medium text-positive-ink shadow-lg">
            {t.hero.freeToday}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FACTS ============ -->
  <section class="border-y border-border bg-card/60">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-y-8 px-4 py-10 sm:px-6 md:grid-cols-4">
      {
        facts.map((f, i) => (
          <div data-reveal style={`--d:${i * 90}ms`} class="px-2 text-center md:border-l md:border-border md:first:border-l-0">
            <p class="num text-4xl font-semibold tracking-tight text-brand-blue">
              <span data-count={f.n}>0</span>{f.suffix}
            </p>
            <p class="mx-auto mt-1 max-w-[12rem] text-sm text-muted-foreground">{f.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ RESIDENTS ============ -->
  <section id="vecinanza" class="scroll-mt-20 py-24 sm:py-32">
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p data-reveal class="text-sm font-semibold uppercase tracking-wider text-brand-blue">{t.residents.eyebrow}</p>
        <h2 data-reveal style="--d:80ms" class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t.residents.title}</h2>
        <ol data-features class="mt-10 space-y-1.5">
          {
            resident.map((f, i) => (
              <li data-reveal style={`--d:${120 + i * 70}ms`}>
                <button
                  type="button"
                  data-feature={i}
                  class:list={[
                    "group relative w-full overflow-hidden rounded-xl px-4 py-3.5 text-left transition-colors hover:bg-card",
                    i === 0 && "on bg-card shadow-sm",
                  ]}
                >
                  <span class="flex items-center gap-4">
                    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-accent-foreground transition-colors group-[.on]:bg-brand-blue group-[.on]:text-white">
                      <f.icon class="size-5" />
                    </span>
                    <span>
                      <span class="block font-semibold">{f.title}</span>
                      <span class="block text-sm text-muted-foreground">{f.text}</span>
                    </span>
                  </span>
                  <span class="progress absolute inset-x-0 bottom-0 h-0.5 bg-brand-blue" style="--dur:4s" />
                </button>
              </li>
            ))
          }
        </ol>
      </div>
      <div data-reveal="zoom" class="relative mx-auto w-[64%] max-w-[300px]">
        <div class="absolute inset-0 -z-10 scale-150 rounded-full bg-[radial-gradient(circle,var(--glow),transparent_60%)]"></div>
        <Phone id="phone-resident" screens={resident.map((f) => ({ src: f.src, alt: f.text }))} interval={0} />
      </div>
    </div>
  </section>

  <!-- ============ TRY IT ============ -->
  <section class="pb-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="mb-10 text-center">
        <h2 data-reveal class="text-3xl font-semibold tracking-tight sm:text-4xl">{t.tryIt.title}</h2>
        <p data-reveal style="--d:80ms" class="mt-2 text-muted-foreground">{t.tryIt.lead}</p>
      </div>
      <div data-reveal="zoom" style="--d:120ms">
        <DayStrip t={t.strip} />
      </div>
    </div>
  </section>

  <!-- ============ AT THE DOOR ============ -->
  <section class="relative overflow-hidden bg-[#0b2544] py-24 text-white sm:py-32">
    <div class="pointer-events-none absolute -left-32 top-1/2 size-[40rem] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(0,150,209,.35),transparent_60%)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr]">
      <div data-reveal="left" class="relative mx-auto w-[60%] max-w-[280px] lg:order-none">
        <!-- rings pulsing out of the phone, like a reader waking up -->
        <span class="ping-ring absolute inset-[15%] rounded-full border-2 border-[#3fb0dd]/50"></span>
        <span class="ping-ring absolute inset-[15%] rounded-full border-2 border-[#3fb0dd]/50" style="animation-delay:1.1s"></span>
        <div class="relative">
          <Phone id="phone-door" screens={doors.map((d) => ({ src: d.src, alt: `${t.door.alt}: ${d.title}` }))} interval={0} />
          <!-- the scan line runs over the QR, only while the reader's QR is on screen -->
          <div data-scan class="pointer-events-none absolute inset-x-[15%] top-[43%] bottom-[25%] transition-opacity duration-300">
            <span class="scanline absolute inset-x-0 h-0.5 rounded-full bg-[#3fb0dd] shadow-[0_0_16px_4px_rgba(63,176,221,.6)]"></span>
          </div>
        </div>
      </div>
      <div>
        <p data-reveal class="text-sm font-semibold uppercase tracking-wider text-[#67bfe3]">{t.door.eyebrow}</p>
        <h2 data-reveal style="--d:80ms" class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t.door.title}</h2>
        <p data-reveal style="--d:140ms" class="mt-4 max-w-md text-white/70">{t.door.lead}</p>
        <div data-doors class="mt-10 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            doors.map((d, i) => (
              <button
                type="button"
                data-door={i}
                data-reveal
                style={`--d:${180 + i * 60}ms`}
                class:list={[
                  "group flex items-center gap-3 rounded-xl border border-white/10 px-4 py-3 text-left text-sm transition-colors hover:bg-white/5",
                  i === 0 && "on bg-white/10 border-[#3fb0dd]/60",
                ]}
              >
                <d.icon class="size-5 text-[#67bfe3] transition-transform group-[.on]:scale-110" />
                {d.title}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COUNCIL ============ -->
  <section id="concello" class="scroll-mt-20 py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p data-reveal class="text-sm font-semibold uppercase tracking-wider text-brand-blue">{t.council.eyebrow}</p>
        <h2 data-reveal style="--d:80ms" class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t.council.title}</h2>
      </div>
      <div data-tabs class="mt-12">
        <div data-reveal class="mx-auto flex max-w-full gap-1 overflow-x-auto rounded-xl border border-border bg-card p-1 sm:w-fit" role="tablist" aria-label={t.council.tabsLabel}>
          {
            council.map((c, i) => (
              <button
                type="button"
                role="tab"
                data-tab={i}
                aria-selected={i === 0 ? "true" : "false"}
                class="flex shrink-0 items-center gap-2 rounded-lg px-3.5 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-accent aria-selected:font-medium aria-selected:text-accent-foreground"
              >
                <c.icon class="size-4" />
                {c.label}
              </button>
            ))
          }
        </div>
        <div data-reveal="zoom" style="--d:120ms" class="mx-auto mt-8 max-w-5xl">
          <Browser url="reservas.concello.gal/admin">
            {
              council.map((c, i) => (
                <Image
                  src={c.src}
                  alt={`${t.council.alt}: ${c.label}`}
                  widths={[700, 1200]}
                  sizes="(min-width:1024px) 1024px, 95vw"
                  class:list={["panel absolute inset-0 h-full w-full object-cover object-top", i === 0 && "on"]}
                />
              ))
            }
          </Browser>
        </div>
      </div>

      <!-- bento -->
      <div class="mt-20 grid gap-4 md:grid-cols-6">
        <!-- ask your data -->
        <article data-reveal data-typer data-questions={JSON.stringify(t.council.questions)} class="relative overflow-hidden rounded-2xl border border-border bg-card p-6 md:col-span-4">
          <div class="flex items-center gap-2 text-sm font-semibold text-brand-blue"><Sparkles class="size-4" /> {t.council.askEyebrow}</div>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight">{t.council.askTitle}</h3>
          <div class="mt-6 flex justify-end">
            <p class="max-w-sm rounded-2xl rounded-br-sm bg-primary px-4 py-2.5 text-sm text-primary-foreground">
              <span data-typed></span><span class="caret">|</span>
            </p>
          </div>
          <div class="mt-5 flex h-28 items-end gap-2" aria-hidden="true">
            {
              [38, 62, 45, 80, 92, 70, 55, 30, 48, 74, 100, 66].map((h, i) => (
                <span class="bar flex-1 rounded-t bg-gradient-to-t from-brand-blue/50 to-brand-blue" style={`height:${h}%; --d:${600 + i * 60}ms`} />
              ))
            }
          </div>
          <p class="mt-3 text-xs text-muted-foreground">{t.council.askNote}</p>
        </article>

        <!-- MCP -->
        <article data-reveal style="--d:80ms" class="rounded-2xl border border-border bg-card p-6 md:col-span-2">
          <div class="grid size-11 place-items-center rounded-xl bg-accent text-accent-foreground"><Bot class="size-5" /></div>
          <h3 class="mt-5 text-xl font-semibold tracking-tight">{t.council.mcpTitle}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{t.council.mcpText}</p>
          <code class="mt-5 block truncate rounded-md bg-muted px-3 py-2 text-xs">/api/mcp</code>
        </article>

        <!-- widget, braille and languages: the same frame at the foot of each card -->
        <article data-reveal class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card md:col-span-2">
          <div class="p-6 pb-0">
            <div class="grid size-11 place-items-center rounded-xl bg-accent text-accent-foreground"><Code2 class="size-5" /></div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight">{t.council.widgetTitle}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{t.council.widgetText}</p>
          </div>
          <div class="relative mx-6 mt-6 h-52 overflow-hidden rounded-t-xl border border-b-0 border-border bg-muted">
            <Image src={cWidget} alt={t.council.widgetAlt} widths={[400, 800]} sizes="(min-width:768px) 340px, 90vw" class="absolute inset-x-0 top-3 w-full translate-y-3 object-cover object-top transition-transform duration-500 group-hover:translate-y-0 dark:brightness-[.85]" />
          </div>
        </article>

        <article data-reveal style="--d:80ms" class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-card md:col-span-2">
          <div class="p-6 pb-0">
