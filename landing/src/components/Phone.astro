---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  screens: { src: ImageMetadata; alt: string }[];
  id?: string;
  /** ms between screens; 0 leaves it to whoever drives it */
  interval?: number;
  class?: string;
  eager?: boolean;
}
const { screens, id, interval = 3200, class: cls, eager = false } = Astro.props;
---

<!-- a Pixel-style Android: aluminium rim, buttons on the right, punch-hole camera, glass glare.
     Everything is sized in cqw so it holds up from the 130px hero phone to the 300px one. -->
<div data-phone data-interval={interval} id={id} class:list={["device-wrap relative", cls]}>
  <div class="device">
    <span class="btn btn-power" aria-hidden="true"></span>
    <span class="btn btn-volume" aria-hidden="true"></span>
    <div class="bezel">
      <div class="glass relative aspect-[540/1200] w-full overflow-hidden bg-[#141517]">
        {
          screens.map((s, i) => (
            <Image
              src={s.src}
              alt={s.alt}
              widths={[300, 540]}
              sizes="(min-width: 768px) 300px, 60vw"
              loading={eager && i === 0 ? "eager" : "lazy"}
              class:list={["screen absolute inset-0 h-full w-full object-cover object-top", i === 0 && "on"]}
              aria-hidden={i === 0 ? undefined : "true"}
            />
          ))
        }
        <span class="camera" aria-hidden="true"></span>
        <span class="glare" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .device-wrap {
    container-type: inline-size;
  }
  .device {
    position: relative;
    /* the rim: brushed aluminium, lit from the top left */
    padding: 1.1cqw;
    border-radius: 13cqw;
    background:
      linear-gradient(145deg, #e9eaec 0%, #9a9da3 18%, #5d6066 42%, #2c2e32 60%, #6f7279 82%, #c9cbcf 100%);
    box-shadow:
      inset 0 0 0 0.25cqw rgba(255, 255, 255, 0.35),
      inset 0 0 0 0.55cqw rgba(0, 0, 0, 0.35),
      0 1.5cqw 3cqw rgba(8, 20, 40, 0.18),
      0 8cqw 16cqw -2cqw rgba(8, 20, 40, 0.35),
      0 22cqw 30cqw -10cqw rgba(8, 20, 40, 0.3);
  }
  .bezel {
    /* thin, even black glass border round the display, like a Pixel */
    padding: 2.6cqw;
    border-radius: 12cqw;
    background: #050506;
    box-shadow: inset 0 0 0.4cqw 0.15cqw rgba(255, 255, 255, 0.06);
  }
  .glass {
    border-radius: 9.6cqw;
    /* keeps the rounded clip while the screenshots scale in */
    isolation: isolate;
  }
  .camera {
    position: absolute;
    top: 2.1cqw;
    left: 50%;
    z-index: 2;
    width: 3.9cqw;
    height: 3.9cqw;
    translate: -50% 0;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 35%, #3b4a66 0 12%, #11141b 28%, #000 62%);
    box-shadow: 0 0 0 0.35cqw #000, inset 0 0 0.3cqw rgba(120, 150, 210, 0.35);
  }
  .glare {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.04) 32%, transparent 33%, transparent 100%);
    border-radius: inherit;
  }
  .btn {
    position: absolute;
    right: -0.75cqw;
    width: 1.1cqw;
    border-radius: 0 0.8cqw 0.8cqw 0;
    background: linear-gradient(90deg, #4a4d53, #b9bcc1 45%, #6c6f75);
    box-shadow: 0.2cqw 0 0.4cqw rgba(0, 0, 0, 0.25);
  }
  .btn-power {
    top: 22%;
    height: 9%;
  }
  .btn-volume {
    top: 35%;
    height: 17%;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-phone]").forEach((phone) => {
    const shots = [...phone.querySelectorAll<HTMLElement>(".screen")];
    let i = 0;
    // forward (and wrapping from the last back to the first) slides in from the right, back from the left
    const show = (n: number, dir = n > i || (n === 0 && i === shots.length - 1) ? 1 : -1) => {
      n = (n + shots.length) % shots.length;
      if (n === i) return;
      const prev = shots[i];
      const next = shots[n];
      // park the next screen on the side it comes from, without animating
      next.style.transition = "none";
      next.classList.toggle("left", dir < 0);
      void next.offsetWidth;
      next.style.transition = "";
      prev.classList.remove("on");
      prev.classList.toggle("left", dir > 0);
      prev.setAttribute("aria-hidden", "true");
      next.classList.remove("left");
      next.classList.add("on");
      next.removeAttribute("aria-hidden");
      i = n;
    };
    phone.addEventListener("phone:show", (e) => show((e as CustomEvent<number>).detail));
    const every = Number(phone.dataset.interval);
    if (!every || shots.length < 2) return;
    let timer = 0;
    const run = () => (timer = window.setInterval(() => show(i + 1, 1), every));
    // only turn pages while the phone is on screen
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) run();
    }).observe(phone);
  });
</script>
