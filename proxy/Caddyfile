# ============================================================
#  LibreQuenda: single entry point
#  Site addresses are set by entrypoint.sh from CADDY_AUTO_HTTPS:
#    http://<domain>   -> plain HTTP (development, or TLS terminated in front)
#    https://<domain>  -> automatic HTTPS (certificates obtained and renewed by Caddy)
# ============================================================

{
	servers {
		# Keep X-Forwarded-* from a TLS-terminating proxy on the private network
		trusted_proxies static private_ranges
	}
	# per-IP limits on the sign-in pages (caddy-ratelimit), before anything else
	order rate_limit before basic_auth
}

# --- Web app + core API ---
{$WEB_ADDRESS} {
	encode zstd gzip

	# /api/health/db -> api:8000/health/db
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Runtime config written by zitadel-setup (OIDC client id, authority)
	handle /config.json {
		root * /srv/runtime
		header Cache-Control "no-store"
		file_server
	}

	# Built files: hashed names, cached for good. A name from an older build is a
	# real 404, not the SPA page served as JavaScript (and then cached for a year).
	handle /assets/* {
		root * /srv/web
		route {
			@missing not file
			respond @missing 404
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}

	# React SPA: unknown paths fall back to index.html, always revalidated so a
	# new build is picked up on the next load. Only the free-turns widget
	# (/<council>/widget[/<facility>]) may be framed by other sites; every
	# other page only by itself (clickjacking).
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		@widget path_regexp ^/[^/]+/widget(/[^/]+)?/?$
		header @widget Content-Security-Policy "frame-ancestors *"
		@framed_by_self not path_regexp ^/[^/]+/widget(/[^/]+)?/?$
		header @framed_by_self Content-Security-Policy "frame-ancestors 'self'"
		header @framed_by_self X-Frame-Options "SAMEORIGIN"
		try_files {path} /index.html
		file_server
	}
}

# --- Identity (Zitadel) ---
{$ZITADEL_ADDRESS} {
	# Zitadel's login has no captcha: per-IP limits on its form posts (Next.js
	# server actions post to the page itself), loose enough for a real person.
	# Over the limit: 429 with Retry-After. {client_ip} honours trusted_proxies.
	rate_limit {
		zone signup {
			match {
				method POST
				path /ui/v2/login/register /ui/v2/login/register/*
			}
			key {client_ip}
			events {$SIGNUP_LIMIT_PER_HOUR:5}
			window 1h
		}
		zone signin {
			match {
				method POST
				path /ui/v2/login/loginname /ui/v2/login/password /ui/v2/login/password/* /ui/v2/login/otp/* /ui/v2/login/u2f /ui/v2/login/passkey /ui/v2/login/verify /ui/v2/login/mfa /ui/v2/login/mfa/*
			}
			key {client_ip}
			events {$SIGNIN_LIMIT_PER_10_MIN:30}
			window 10m
		}
	}

	# Login v2 UI (Next.js)
	handle /ui/v2/login* {
		reverse_proxy zitadel-login:3000
	}

	# Bare domain opens the login
	handle / {
		rewrite * /ui/v2/login/
		reverse_proxy zitadel-login:3000
	}

	# Everything else: OIDC, console, APIs (gRPC / Connect over h2c)
	handle {
		reverse_proxy h2c://zitadel-api:8080
	}
}
