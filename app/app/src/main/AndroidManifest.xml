<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- distances on Home and public bookings nearby; asked for, never stored -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- checking in with the entry code or the door QR: the API checks the phone is at the facility (never stored) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- notifications without push: reminders as local alarms, the rest checked in the background -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the NFC tag on a facility's door, read while the check-in or flash booking page shows -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:theme="@style/Theme.LibreQuenda">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- a booking's reminder, 15 minutes before -->
        <receiver android:name=".notify.ReminderReceiver" android:exported="false" />
        <!-- «mark as read» on a notice's notification -->
        <receiver android:name=".notify.MarkReadReceiver" android:exported="false" />
        <!-- after a restart, the reminders are scheduled again -->
        <receiver android:name=".notify.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
