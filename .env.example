# ============================================================
#  LibreQuenda: copy to .env on the server and fill in every value.
#  Generate the secrets (commands next to each one); never reuse values
#  from another installation. The stack refuses to start while one is missing.
# ============================================================

POSTGRES_DB=librequenda
POSTGRES_USER=librequenda
# tr -dc A-Za-z0-9 </dev/urandom | head -c 32
POSTGRES_PASSWORD=
# The API logs in as librequenda_app (data only, subject to row-level security). Same generator as above.
APP_DB_PASSWORD=
# the read-only user the analytics assistant queries with (db/init/08_analytics_role.sh)
ANALYTICS_DB_PASSWORD=
# Image tag pulled from ghcr.io/tribosolutions/librequenda-*: latest (the newest main),
# or a release (e.g. 1.2.3) to stay on it. Update with: docker compose pull && docker compose up -d --wait
LIBREQUENDA_VERSION=latest

# Public addresses: Caddy obtains TLS certificates automatically for these domains.
# Both domains must point (DNS A/AAAA) to this server, and ports 80 and 443 must be open.
PUBLIC_SCHEME=https
PUBLIC_PORT=443
WEB_DOMAIN=reservas.example.gal
ZITADEL_DOMAIN=auth.reservas.example.gal
ZITADEL_EXTERNALSECURE=true
# Caddy automatic HTTPS: true = Caddy gets and renews Let's Encrypt certificates (needs ports 80/443 open).
# Set to false if another proxy / load balancer in front already terminates TLS; keep PUBLIC_SCHEME=https.
CADDY_AUTO_HTTPS=true
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Zitadel (identity)
ZITADEL_VERSION=v4.20.0
# Exactly 32 characters. Cannot be changed after the first start: back it up.
# tr -dc A-Za-z0-9 </dev/urandom | head -c 32
ZITADEL_MASTERKEY=
# openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
# tr -dc A-Za-z0-9 </dev/urandom | head -c 32
ZITADEL_DB_PASSWORD=
# First Zitadel admin (the operator's real email). Only applied on the very first start.
# Login name; empty = ZITADEL_ADMIN_EMAIL. Without "@", Zitadel shows <name>@zitadel.<ZITADEL_DOMAIN>.
ZITADEL_ADMIN_USERNAME=
ZITADEL_ADMIN_EMAIL=
ZITADEL_ADMIN_FIRSTNAME=
ZITADEL_ADMIN_LASTNAME=
ZITADEL_ADMIN_PASSWORD=

# Optional: "Sign in with Google" on the login page. Leave empty to disable.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: https://<ZITADEL_DOMAIN>/idps/callback
# true: offer passkeys besides the password at sign-up and sign-in
ZITADEL_PASSKEYS=false
# Access tokens last this many minutes (5-15 recommended): a blocked account or a
# removed role stops working that soon. The web renews them silently with its
# refresh token, which expires after this many idle days, and at most after REFRESH_DAYS.
ZITADEL_ACCESS_TOKEN_MINUTES=10
ZITADEL_REFRESH_IDLE_DAYS=30
ZITADEL_REFRESH_DAYS=90
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your own build of the Android app (install.sh app): its applicationId, so sign-in can
# return to it. Comma-separated for several. Empty = only the LibreQuenda app.
ANDROID_APP_IDS=

# First superadministrator: creates councils at /admin. Empty = ZITADEL_ADMIN_EMAIL.
# Granted when this person signs in with the email verified.
SUPERADMIN_EMAIL=

# Support: shown in the app's menu and the web's footer, for people who do not understand
# something. Optional: leave empty to hide (e.g. soporte@concello.gal, +34 981 000 000).
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Image storage: Garage (self-hosted, S3-compatible). Generate every value:
STORAGE_BUCKET=media
# GK + output of: openssl rand -hex 12
STORAGE_ACCESS_KEY=
# openssl rand -hex 32
STORAGE_SECRET_KEY=
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Backups: every day at BACKUP_AT (Europe/Madrid), a dump of PostgreSQL (LibreQuenda's and
# Zitadel's databases) goes into the BACKUP_BUCKET bucket of this server's Garage and is
# kept BACKUP_KEEP_DAYS days. Optional: these are the defaults.
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
BACKUP_BUCKET=backups
# Off this server (recommended: a disk failure takes Garage with it): another S3-compatible
# storage. Empty = this server's Garage, with the STORAGE_* keys.
BACKUP_S3_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Email: your SMTP relay (STARTTLS on 587).
# LibreQuenda sends booking confirmations, reminders with the QR, cancellations and
# administrator invitations through it, for every council that has not set up its own
# relay (council admin, "Email" tab). Zitadel sends verification codes and password
# resets through it too, so set it unless Zitadel gets its own.
# days the audit log keeps administrators' actions (default 730, two years)
AUDIT_RETENTION_DAYS=730
# days the email log keeps every email sent or failed (default 365); superadministrators read it at /admin
EMAIL_LOG_RETENTION_DAYS=365
# days the API's rotated log files are kept (api-logs volume; rotated at 20 MB)
LOG_KEEP_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LibreQuenda <noreply@example.gal>
# Encrypts the SMTP passwords councils save in their admin. Keep it with your backups:
# without it those passwords must be typed again. openssl rand -hex 32
SECRETS_KEY=
# The bare address of SMTP_FROM, for Zitadel
SMTP_FROM_ADDRESS=noreply@example.gal
# true only if the relay uses implicit TLS (port 465)
ZITADEL_SMTP_TLS=false

# Council administrators and superadministrators must sign in with a second
# factor (an authenticator app, a security key or a passkey) to use the
# administration. On by default in docker-compose.yaml; set false only for a
# test installation. The local development stack leaves it off.
REQUIRE_ADMIN_MFA=true

# The setup's instance-owner token (zitadel-admin volume): revoke it once the
# setup succeeds (later starts keep the configuration), and its expiry on the
# very first start.
ZITADEL_SETUP_REVOKE_TOKEN=false
ZITADEL_ADMIN_PAT_EXPIRATION=2099-01-01T00:00:00Z

# Per-IP limits on Zitadel's sign-in pages, at the proxy (its login has no
# captcha): account registrations per hour, and sign-in, password, code and
# email-verification attempts per 10 minutes. Over them: 429, retry later.
SIGNUP_LIMIT_PER_HOUR=5
SIGNIN_LIMIT_PER_10_MIN=30
